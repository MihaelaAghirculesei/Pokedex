{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "Interactive Pokédex built with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "optimize:images": "node scripts/optimize-bg.mjs && node scripts/resize-icons.mjs && node scripts/convert-webp.mjs",
    "ci:local": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run test:e2e && npm audit --audit-level=high --omit=dev",
    "analyze": "vite build --mode analyze",
    "size": "size-limit",
    "test:lighthouse": "lhci autorun",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/Pokedex.git"
  },
  "author": "Mihaela Melania Aghirculesei",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@types/dompurify": "^3.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "dompurify": "^3.4.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "size-limit": [
    {
      "name": "main JS",
      "path": "dist/assets/main-*.js",
      "limit": "10 kB"
    },
    {
      "name": "vendor JS",
      "path": "dist/assets/vendor-*.js",
      "limit": "15 kB"
    },
    {
      "name": "main CSS",
      "path": "dist/assets/main-*.css",
      "limit": "5 kB"
    }
  ]
}
