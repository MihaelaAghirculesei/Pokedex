{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "Interactive Pokédex built with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize-bg.mjs && node scripts/resize-icons.mjs && node scripts/convert-webp.mjs",
    "ci:local": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run size && npm run test:e2e && npm audit --audit-level=high --omit=dev",
    "analyze": "vite build --mode analyze",
    "size": "size-limit",
    "test:e2e": "playwright test",
    "test:e2e:functional": "playwright test e2e/app.spec.ts e2e/accessibility.spec.ts e2e/mobile.spec.ts",
    "e2e:visual:ci": "playwright test e2e/visual.spec.ts --reporter=dot",
    "e2e:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "lighthouse:ci": "lhci autorun",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,html,md}": "prettier --write",
    "src/**/*.ts": "eslint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/Pokedex.git"
  },
  "author": "Mihaela Melania Aghirculesei",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "^1.6.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "@sentry/browser": "^10.53.1",
    "dompurify": "^3.4.8"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "size-limit": [
    {
      "name": "main JS",
      "path": "dist/assets/main-*.js",
      "limit": "10 kB"
    },
    {
      "name": "interaction JS",
      "path": "dist/assets/interaction-*.js",
      "limit": "20 kB"
    },
    {
      "name": "main CSS",
      "path": "dist/assets/main-*.css",
      "limit": "5 kB"
    }
  ]
}
