{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "Interactive Pokédex built with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "ci:local": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/Pokedex.git"
  },
  "author": "Mihaela Melania Aghirculesei",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0"
  },
  "dependencies": {
    "dompurify": "^3.4.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
